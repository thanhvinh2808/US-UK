# Server Configuration
PORT=5000
NODE_ENV=production

# Security & Secrets (Placeholders - Set securely in your environment)
JWT_SECRET=your_jwt_secret_at_least_64_characters_long_required
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Database
MONGODB_URI=mongodb://localhost:27017/antigravity_english

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API URL
VITE_API_URL=http://localhost:5000/api
